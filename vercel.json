{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "excludeFiles": "public/**" } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=31536000",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
      },
      "continue": true
    },
    { "src": "/(?:_src|\\.git|\\.env|api|frontend|reports|templates|schemas)(?:/.*)?", "status": 404 },
    { "src": "/(?:public-build|deployment-manifest)\\.json", "status": 404 },
    { "src": "/assets/(.*)", "methods": ["GET", "HEAD"], "dest": "/public/assets/$1" },
    { "src": "/static/(.*)", "methods": ["GET", "HEAD"], "dest": "/public/assets/$1" },
    { "src": "/data/releases/current\\.json", "methods": ["GET", "HEAD"], "headers": { "Cache-Control": "no-store, max-age=0" }, "dest": "/public/data/releases/current.json" },
    { "src": "/data/releases/([A-Za-z0-9][A-Za-z0-9._-]*)\\.json", "methods": ["GET", "HEAD"], "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "dest": "/public/data/releases/$1.json" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
