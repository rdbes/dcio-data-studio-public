{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "env": {
    "SUPABASE_AUTH_REQUIRED": "0",
    "PUBLIC_DATA_SOURCE": "supabase"
  },
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "excludeFiles": "public/**" } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=31536000",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "SAMEORIGIN",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
      },
      "continue": true
    },
    { "src": "/(?:_src|\\.git|\\.env|api|frontend|reports|templates|schemas|admin|upload-report)(?:/.*)?", "status": 404 },
    { "src": "/(?:public-build|deployment-manifest)\\.json", "status": 404 },
    { "src": "/assets/(.*)", "methods": ["GET", "HEAD"], "dest": "/public/assets/$1" },
    { "src": "/static/(.*)", "methods": ["GET", "HEAD"], "dest": "/public/assets/$1" },
    { "src": "/data/drought/current\\.json", "methods": ["GET", "HEAD"], "dest": "/api/index.py" },
    { "src": "/data/(?:releases|drought)(?:/.*)?", "status": 404 },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
