{
  "version": 2,
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python", "config": { "excludeFiles": "public/**" } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/static/(.*)", "dest": "/public/assets/$1" },
    { "src": "/data/releases/current.json", "headers": { "Cache-Control": "no-store, max-age=0" }, "dest": "/public/data/releases/current.json" },
    { "src": "/data/releases/(.*).json", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "dest": "/public/data/releases/$1.json" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
